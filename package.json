{
  "name": "react-quiz",
  "version": "0.9.2",
  "description": "React Quiz",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "rimraf dist && vite build",
    "preview": "rimraf dist && vite preview",
    "bundle": "rimraf dist && vite build --mode production",
    "lint": "eslint src --ext .jsx --ext .js --fix",
    "deploy": "rimraf dist && npm run build && gh-pages -d dist --nojekyll"
  },
  "keywords": [
    "react",
    "reactjs",
    "react-quiz-component",
    "react-quiz",
    "quiz"
  ],
  "license": "MIT",
  "devDependencies": {
    "eslint": "^8.4.1",
    "eslint-config-airbnb": "^19.0.2",
    "eslint-plugin-import": "^2.25.3",
    "eslint-plugin-jsx-a11y": "^6.5.1",
    "eslint-plugin-react": "^7.27.1",
    "eslint-plugin-react-hooks": "^4.3.0",
    "gh-pages": "^6.3.0",
    "rimraf": "^6.1.3"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.1.4",
    "dompurify": "^3.0.0",
    "nanoid": "^5.0.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "snarkdown": "^2.0.0",
    "vite": "^7.3.1"
  }
}
